# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for browser use when Row Level Security is enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not required by the app. Server-only secret for trusted administrative tasks.
# Never expose this value in client-side code.
SUPABASE_SERVICE_ROLE_KEY=
